{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "EET Mod Runner",
  "version": "0.9.0",
  "identifier": "com.eetmodforge.runner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EET Mod Runner",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "patches/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNTQyQzIyNTlENDMxMjkKUldRcE1kUlpJaXhVSGgwUE1PK1JUdWZPaXpjS1BpWldWaWRvRXJWS2hjZktLNXovNGwyUnBSczkK",
      "endpoints": [
        "https://github.com/Anprionsa/eet-mod-runner/releases/latest/download/latest.json"
      ]
    }
  }
}
