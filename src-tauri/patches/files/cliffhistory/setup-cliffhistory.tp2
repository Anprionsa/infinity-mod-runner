COPY 	~CliffHistory\Portraits\CLFHSFXL.bmp~     ~override~
       	~CliffHistory\Portraits\CLFHSFXS.bmp~     ~override~
// FIX: Original copied to ~portraits~ (a file). Must copy to ~portraits/filename~
// or the portraits directory gets overwritten with a BMP file, breaking Valen,
// Mur'Neth, Uldar, and any other mod that copies portraits to the directory.
MKDIR ~portraits~
COPY 	~CliffHistory\Portraits\CLFHSFXL.bmp~     ~portraits/CLFHSFXL.bmp~
       	~CliffHistory\Portraits\CLFHSFXS.bmp~     ~portraits/CLFHSFXS.bmp~
