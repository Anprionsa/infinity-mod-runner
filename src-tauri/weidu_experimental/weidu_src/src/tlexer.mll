  (* render a token kind code as a string *)
  let tokenKindDesc (t:int) : string =
  begin
    match t with
    | 0  ->       "EOF"
    | 1  ->       "[]"
    | 2  ->       "~~"
    | 3  ->       "<<<<<<<<"
    | 4  ->       "#"
    | 5  ->       "@"
    | 6  ->       "!"
    | 7  ->       "START_FROM_TP"
    | 8  ->       "START_FROM_TPA"
    | 9  ->       "START_FROM_TPP"
