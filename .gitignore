logo-preview.html
logo-1024.png

# Internal dev notes (not for public consumption)
docs/

# Local patch safety snapshots
src-tauri/patches/.backup_v1_safe_state/

# Vendored WeiDU build artifacts — CI regenerates these on every build
src-tauri/weidu_experimental/weidu_src/obj/
src-tauri/weidu_experimental/weidu_src/bin/
src-tauri/weidu_experimental/weidu_src/**/*.cmx
src-tauri/weidu_experimental/weidu_src/**/*.cmi
src-tauri/weidu_experimental/weidu_src/**/*.cmo
src-tauri/weidu_experimental/weidu_src/**/*.cma
src-tauri/weidu_experimental/weidu_src/**/*.o
src-tauri/weidu_experimental/weidu_src/**/*.a

# Generated source files — copied/built from platform-specific siblings by `make`.
# The .in / .gr / arch_*.ml / case_ins_*.ml sources ARE tracked; these outputs are not.
src-tauri/weidu_experimental/weidu_src/src/arch.ml
src-tauri/weidu_experimental/weidu_src/src/case_ins.ml
src-tauri/weidu_experimental/weidu_src/src/tph.ml
src-tauri/weidu_experimental/weidu_src/src/tlexer.mll
src-tauri/weidu_experimental/weidu_src/src/toldlexer.mll
src-tauri/weidu_experimental/weidu_src/src/trealparserin.gr

# Built executables and zip artifacts at weidu_src root. `make` copies the
# final binary to the root (`cp $(PROJECT_EXECUTABLE) .`) before the zip step,
# and `make *_zip` writes WeiDU-<Platform>-<ver>.zip there too. None should
# be tracked — CI produces all of these per-platform.
src-tauri/weidu_experimental/weidu_src/weidu.exe
src-tauri/weidu_experimental/weidu_src/weidu
src-tauri/weidu_experimental/weidu_src/*.asm.exe
src-tauri/weidu_experimental/weidu_src/weinstall.exe
src-tauri/weidu_experimental/weidu_src/weinstall
src-tauri/weidu_experimental/weidu_src/tolower.exe
src-tauri/weidu_experimental/weidu_src/tolower
src-tauri/weidu_experimental/weidu_src/WeiDU-*.zip
src-tauri/weidu_experimental/weidu_src/WeiDU-Windows/
src-tauri/weidu_experimental/weidu_src/WeiDU-Linux/
src-tauri/weidu_experimental/weidu_src/WeiDU-Mac/

# Python bytecode (any stray __pycache__ in helper scripts)
__pycache__/
*.pyc

# Runtime logs
*.log
!src-tauri/src/*.rs
